[Unit]
Description=Filebeat CDRs Service
After=network.target

[Service]
Type=simple
User=mahmoud-mattar
WorkingDirectory=/work/ELK/filebeat-9.3.0-linux-x86_64
ExecStart=/work/ELK/filebeat-9.3.0-linux-x86_64/filebeat -e -c /work/ELK/filebeat-9.3.0-linux-x86_64/filebeat-cdrs.yml --strict.perms=false
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
