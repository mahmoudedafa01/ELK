[Unit]
Description=Elasticsearch CDRs Service
After=network.target

[Service]
Type=simple
User=mahmoud-mattar
WorkingDirectory=/work/ELK/elasticsearch-9.3.0
ExecStart=/work/ELK/elasticsearch-9.3.0/bin/elasticsearch
Restart=always
RestartSec=5
LimitNOFILE=65535
LimitNPROC=4096
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
